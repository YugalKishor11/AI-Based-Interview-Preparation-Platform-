# ==========================================
# PrepSphere Canonical Environment Configuration (.env.example)
# Copy to .env.local for local overrides. Placeholders only. Never commit real keys.
# ==========================================

# Data Source: 'mock' (standalone in-memory) or 'supabase' (Postgres + Edge Functions)
VITE_DATA_SOURCE=mock

# Supabase Project Credentials (required when VITE_DATA_SOURCE=supabase)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key-here

# Google Gemini API (Interviewer Agent, Drill Evaluation & Analysis)
VITE_GEMINI_API_KEY=your-gemini-api-key-here
VITE_GEMINI_MODEL=gemini-3.8-flash

# Developer Tools Drawer & Design Showcase in Build
VITE_SHOW_DEV=true

# Optional: Privacy-First Analytics (Plausible)
VITE_PLAUSIBLE_DOMAIN=prepsphere.io

# Optional: Error Monitoring (Sentry - all transcripts and PII auto-scrubbed)
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional: Isolated Coding Interview Execution Sandbox
VITE_CODE_SANDBOX_URL=
